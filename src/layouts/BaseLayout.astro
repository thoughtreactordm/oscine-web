---
import { getImage } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import '../styles/global.css'
import AppMain from '../components/AppMain.vue'
import Lightbox from '../components/Lightbox.vue'
import SiteFooter from '../components/SiteFooter.vue'
import SiteHeader from '../components/SiteHeader.vue'
import ogDefault from '../assets/screenshots/crops/og.png'
import { shotAlt } from '../data/learn-shots'
// Preload the latin faces so text does not paint in the fallback font first
// (fontsource declares them with font-display: swap).
import robotoLatin from '@fontsource-variable/roboto/files/roboto-latin-wght-normal.woff2?url'
import soraLatin from '@fontsource-variable/sora/files/sora-latin-wght-normal.woff2?url'

interface Props {
  title?: string
  description?: string
  ogImage?: ImageMetadata
  ogImageAlt?: string
  /** Mount the Lightbox island. Only pages with `[data-zoom]` shots need it. */
  zoom?: boolean
}

const {
  title = 'Oscine — a local music player',
  description = 'Oscine is a local music player for Windows and Linux. Power-user control, a modern interface, and a shell you can make yours.',
  ogImage = ogDefault,
  ogImageAlt = shotAlt('og'),
  zoom = false
} = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site)
const og = await getImage({ src: ogImage, width: 1200, height: 630, format: 'png' })
const ogUrl = new URL(og.src, Astro.site).href
const ogWidth = String(og.attributes.width ?? 1200)
const ogHeight = String(og.attributes.height ?? 630)
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c0a09" />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={robotoLatin} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={soraLatin} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:width" content={ogWidth} />
    <meta property="og:image:height" content={ogHeight} />
    <meta property="og:image:type" content="image/png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <title>{title}</title>
  </head>
  <body class="min-h-dvh bg-default text-default antialiased">
    <div class="isolate">
      <SiteHeader client:load currentPath={Astro.url.pathname} />
      <AppMain>
        <slot />
      </AppMain>
      <SiteFooter />
      {zoom && <Lightbox client:idle />}
    </div>
  </body>
</html>
