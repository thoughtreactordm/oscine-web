---
import FaqAccordion from '../components/FaqAccordion.vue'
import HeroByline from '../components/HeroByline.vue'
import HomeLanding from '../components/HomeLanding.vue'
import { getImage } from 'astro:assets'
import Screenshot from '../components/Screenshot.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { getLatestRelease } from '../data/release'
import { shotAlt } from '../data/learn-shots'
import { bloom } from '../data/bloom'
import libraryHero from '../assets/screenshots/library-hero.png'
// Built by tools/capture/hero.mjs from the record.mjs flows.
import heroWebm from '../assets/video/hero.webm'
import heroMp4 from '../assets/video/hero.mp4'
import tunedeckTrack from '../assets/screenshots/tunedeck-track.png'
import pillarColumns from '../assets/screenshots/crops/pillar-columns.png'
import pillarStage from '../assets/screenshots/crops/pillar-stage.png'
import pillarThemePicker from '../assets/screenshots/crops/pillar-theme-picker.png'
import exploreDiscover from '../assets/screenshots/crops/explore-discover.png'
import exploreStats from '../assets/screenshots/crops/explore-stats.png'

const release = await getLatestRelease()
const blooms = {
  hero: bloom('library-hero'),
  pillarColumns: bloom('crops/pillar-columns'),
  pillarStage: bloom('crops/pillar-stage'),
  pillarThemePicker: bloom('crops/pillar-theme-picker'),
  tunedeckTrack: bloom('tunedeck-track'),
  exploreDiscover: bloom('crops/explore-discover'),
  exploreStats: bloom('crops/explore-stats')
}

// The still is the video's poster, so it's also what reduced-motion visitors
// (and anyone before the first frame decodes) see. It matches the video's
// opening frame, so playback starting doesn't jump.
const heroPoster = await getImage({ src: libraryHero, width: 1920, format: 'webp' })
---

<BaseLayout
  title="A Future Forward Music Player · Oscine"
  description="Oscine is a free, customizable music player for Windows and Linux that plays the library you already own. It has a parametric equalizer, CD ripping, tag editing, and ReplayGain measurement built in."
  zoom
>
  <HomeLanding release={release} blooms={blooms}>
    {/* Islands take their slot from a Fragment: a `slot` prop on the island
        itself reaches the client but not the server render, and Vue reports
        the difference as a hydration mismatch. */}
    <Fragment slot="hero-byline"><HeroByline client:load /></Fragment>
    {/* Started by the script below, not `autoplay`, so reduced-motion
        visitors never download it unless they press play. */}
    <video
      slot="hero"
      class="hero-video"
      width="1920"
      height="1230"
      muted
      loop
      playsinline
      preload="none"
      poster={heroPoster.src}
      aria-label="Oscine scrolling and searching a library, then glimpses of the Tunedeck, Discover and Stats, the Stage cover growing into a visualizer with synced lyrics, the app in light and Nocturne themes and the theme editor, and equalizer bands being dragged on the curve."
    >
      {/* Main profile, level 5.0, 8-bit: what SVT-AV1 signals here. */}
      <source src={heroWebm} type='video/webm; codecs="av01.0.12M.08"' />
      <source src={heroMp4} type="video/mp4" />
    </video>
    <Screenshot
      slot="pillar-columns"
      src={pillarColumns}
      alt={shotAlt('pillar-columns')}
      sizes="(min-width: 1024px) 22rem, 100vw"
    />
    <Screenshot
      slot="pillar-stage"
      src={pillarStage}
      alt={shotAlt('pillar-stage')}
      sizes="(min-width: 1024px) 22rem, 100vw"
    />
    <Screenshot
      slot="pillar-theme-picker"
      src={pillarThemePicker}
      alt={shotAlt('pillar-theme-picker')}
      sizes="(min-width: 1024px) 22rem, 100vw"
    />
    <Screenshot
      slot="tunedeck-track"
      src={tunedeckTrack}
      alt={shotAlt('tunedeck-track')}
      sizes="(min-width: 1024px) 36rem, 100vw"
    />
    <Screenshot
      slot="explore-discover"
      src={exploreDiscover}
      alt={shotAlt('explore-discover')}
      widths={[640, 1280]}
      sizes="(min-width: 1024px) 18rem, 50vw"
    />
    <Screenshot
      slot="explore-stats"
      src={exploreStats}
      alt={shotAlt('explore-stats')}
      widths={[640, 1280]}
      sizes="(min-width: 1024px) 18rem, 50vw"
    />
    <Fragment slot="faqs"><FaqAccordion client:visible /></Fragment>
  </HomeLanding>
</BaseLayout>

<script>
  // Hold the pinned headline while the screenshot rises behind it, then slide it
  // up to follow the shot off the top. Native sticky keeps the headline planted
  // at the crown for free; the moment the shot's trailing edge dissolves past
  // the header line we mirror the shot's continued rise onto the headline as an
  // upward transform, so it leaves with the shot instead of sitting frozen for a
  // viewport after everything else has gone. Transform-only — no reflow, no jump
  // — and the trigger is read from the shot itself, never a guessed distance.
  const hero = document.querySelector('.hero')
  const copy = hero?.querySelector('.hero-copy') as HTMLElement | null
  const shot = hero?.querySelector('.hero-shot-track') as HTMLElement | null
  const header = document.querySelector('header')

  // With reduced motion the stylesheet unpins the headline and the hero scrolls
  // as an ordinary page, so the follow-the-shot lift is switched off too. The
  // query is watched so flipping the OS setting mid-visit takes effect at once.
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)')

  if (hero && copy && shot) {
    let ticking = false

    const sync = () => {
      ticking = false
      if (reduceMotion.matches) {
        copy.style.transform = ''
        return
      }
      // The line the shot fades into: the bottom of the sticky header.
      const line = header ? header.getBoundingClientRect().bottom : 64
      const lift = Math.max(0, line - shot.getBoundingClientRect().bottom)
      copy.style.transform = lift ? `translateY(${-lift}px)` : ''
    }

    const onScroll = () => {
      if (!ticking && !reduceMotion.matches) {
        ticking = true
        requestAnimationFrame(sync)
      }
    }

    addEventListener('scroll', onScroll, { passive: true })
    addEventListener('resize', onScroll, { passive: true })
    reduceMotion.addEventListener('change', sync)
    sync()
  }

  // The hero video plays while it's on screen, unless the visitor prefers
  // reduced motion or has paused it themselves. The toggle works either way, so
  // a reduced-motion visitor can still choose to watch it.
  const video = hero?.querySelector('.hero-video') as HTMLVideoElement | null
  const toggle = hero?.querySelector('[data-hero-toggle]') as HTMLButtonElement | null

  if (video && toggle) {
    let userChoice: 'play' | 'pause' | null = null
    let onScreen = true

    const reflect = () => {
      const playing = !video.paused
      toggle.dataset.playing = String(playing)
      toggle.setAttribute('aria-label', playing ? 'Pause video' : 'Play video')
    }

    const update = () => {
      const wanted = userChoice ? userChoice === 'play' : !reduceMotion.matches
      if (wanted && onScreen) video.play().catch(() => {})
      else video.pause()
    }

    video.addEventListener('play', reflect)
    video.addEventListener('pause', reflect)
    toggle.addEventListener('click', () => {
      userChoice = video.paused ? 'play' : 'pause'
      update()
    })
    reduceMotion.addEventListener('change', update)
    new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting
      update()
    }).observe(video)

    toggle.hidden = false
    reflect()
    update()
  }
</script>
