---
import FaqAccordion from '../components/FaqAccordion.vue'
import HeroByline from '../components/HeroByline.vue'
import HomeLanding from '../components/HomeLanding.vue'
import Screenshot from '../components/Screenshot.astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { getLatestRelease } from '../data/release'
import { shotAlt } from '../data/learn-shots'
import { bloom } from '../data/bloom'
import libraryHero from '../assets/screenshots/library-hero.png'
import tunedeckTrack from '../assets/screenshots/tunedeck-track.png'
import pillarColumns from '../assets/screenshots/crops/pillar-columns.png'
import pillarStage from '../assets/screenshots/crops/pillar-stage.png'
import pillarThemePicker from '../assets/screenshots/crops/pillar-theme-picker.png'

const release = await getLatestRelease()
const blooms = {
  hero: bloom('library-hero'),
  pillarColumns: bloom('crops/pillar-columns'),
  pillarStage: bloom('crops/pillar-stage'),
  pillarThemePicker: bloom('crops/pillar-theme-picker'),
  tunedeckTrack: bloom('tunedeck-track')
}
---

<BaseLayout
  title="Oscine — Your library, taken seriously."
  description="A local music player with foobar2000's control, an interface from this decade, and a shell you can make yours."
  zoom
>
  <HomeLanding release={release} blooms={blooms}>
    <HeroByline slot="hero-byline" client:load />
    <Screenshot
      slot="hero"
      src={libraryHero}
      alt={shotAlt('library-hero')}
      loading="eager"
      fetchpriority="high"
    />
    <Screenshot
      slot="pillar-columns"
      src={pillarColumns}
      alt={shotAlt('pillar-columns')}
      sizes="(min-width: 1024px) 22rem, 100vw"
    />
    <Screenshot
      slot="pillar-stage"
      src={pillarStage}
      alt={shotAlt('pillar-stage')}
      sizes="(min-width: 1024px) 22rem, 100vw"
    />
    <Screenshot
      slot="pillar-theme-picker"
      src={pillarThemePicker}
      alt={shotAlt('pillar-theme-picker')}
      sizes="(min-width: 1024px) 22rem, 100vw"
    />
    <Screenshot
      slot="tunedeck-track"
      src={tunedeckTrack}
      alt={shotAlt('tunedeck-track')}
      sizes="(min-width: 1024px) 36rem, 100vw"
    />
    <FaqAccordion slot="faqs" client:visible />
  </HomeLanding>
</BaseLayout>

<script>
  // Hold the pinned headline while the screenshot rises behind it, then slide it
  // up to follow the shot off the top. Native sticky keeps the headline planted
  // at the crown for free; the moment the shot's trailing edge dissolves past
  // the header line we mirror the shot's continued rise onto the headline as an
  // upward transform, so it leaves with the shot instead of sitting frozen for a
  // viewport after everything else has gone. Transform-only — no reflow, no jump
  // — and the trigger is read from the shot itself, never a guessed distance.
  const hero = document.querySelector('.hero')
  const copy = hero?.querySelector('.hero-copy') as HTMLElement | null
  const shot = hero?.querySelector('.hero-shot-track') as HTMLElement | null
  const header = document.querySelector('header')

  if (hero && copy && shot) {
    let ticking = false

    const sync = () => {
      ticking = false
      // The line the shot fades into: the bottom of the sticky header.
      const line = header ? header.getBoundingClientRect().bottom : 64
      const lift = Math.max(0, line - shot.getBoundingClientRect().bottom)
      copy.style.transform = lift ? `translateY(${-lift}px)` : ''
    }

    const onScroll = () => {
      if (!ticking) {
        ticking = true
        requestAnimationFrame(sync)
      }
    }

    addEventListener('scroll', onScroll, { passive: true })
    addEventListener('resize', onScroll, { passive: true })
    sync()
  }
</script>
