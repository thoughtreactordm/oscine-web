---
import DownloadView from '../components/DownloadView.vue'
import BaseLayout from '../layouts/BaseLayout.astro'
import { getLatestRelease } from '../data/release'

const release = await getLatestRelease()
---

<BaseLayout
  title="Download Oscine"
  description="Download Oscine for Windows and Linux. A free local music player for the library you already own."
>
  <DownloadView release={release} />
</BaseLayout>
