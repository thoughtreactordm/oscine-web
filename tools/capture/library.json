  "podcasts": [
    {
      "title": "The Skip Button",
      "slug": "the-skip-button",
      "author": "Skip Rate",
      "description": "Conversations about the songs nobody finishes, with the people who wrote the parts that got skipped.",
      "episodes": [
        { "title": "The Intro Problem", "description": "Why the first eleven seconds decide everything, and what that did to intros.", "minutes": 1.2 },
        { "title": "Eleven Seconds In", "description": "A producer walks through a chorus that now arrives before the song does.", "minutes": 1.4 },
        { "title": "A Bridge Too Long", "description": "The bridge used to be the best part. Then it became the part people left.", "minutes": 1.1 },
        { "title": "The Outro Nobody Hears", "description": "On fade-outs, autoplay, and the final thirty seconds as a courtesy.", "minutes": 1.5 },
        { "title": "Season Finale (Skipped)", "description": "We look back on a season that most listeners got halfway through.", "minutes": 1.0 }
      ]
    },
    {
      "title": "Please Hold",
      "slug": "please-hold",
      "author": "The Buffers",
      "description": "A podcast about waiting for things to load.",
      "episodes": [
        { "title": "Spinning Wheels", "description": "A short history of the loading indicator, and why it lies.", "minutes": 1.3 },
        { "title": "The 2% Problem", "description": "Nothing buffers like the last two percent.", "minutes": 1.0 },
        { "title": "Reconnecting, Again", "description": "Stories from the tunnel between two stations.", "minutes": 1.4 },
        { "title": "Offline Mode and Other Lies", "description": "Your downloads are not yours. A conversation about caches.", "minutes": 1.6 },
        { "title": "Sync Required", "description": "Thirty days since your last connection. Please hold.", "minutes": 1.1 },
        { "title": "Season Finale (Buffering)", "description": "We wrap the season, eventually.", "minutes": 1.2 }
      ]
    }
  ]
}
